		book.addRecipe(recipe2);
		String deletedRecipeName = book.deleteRecipe(1);
		assertEquals("Latte", deletedRecipeName, "Incorrect recipe name returned after deleting a recipe");
		Recipe[] recipes = book.getRecipes();
		assertEquals(4, recipes.length, "Deleting a recipe should not change the number of recipes in the book");
		assertNull(recipes[1], "Deleting a recipe should set its index to null");
	}

	@Test
	void testEditRecipe() {

// Test editing recipes in the book
		assertNull(book.editRecipe(0, recipe1), "Editing a recipe at an empty index should return null");
