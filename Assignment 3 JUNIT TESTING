		recipe1 = new Recipe();
		recipe1.setName("Espresso");
		recipe2 = new Recipe();
		recipe2.setName("Latte");
		recipe3 = new Recipe();
		recipe3.setName("Mocha");
		recipe4 = new Recipe();
		recipe4.setName("Cappuccino");
	}

	@Test
	void testGetRecipes() {

// Test if getting recipes returns an array of 4 recipes
		Recipe[] recipes = book.getRecipes();
		assertNotNull(recipes, "Failed to return an array of recipes");
		assertEquals(4, recipes.length, "Incorrect number of recipes returned");
	}

	@Test
	void testAddRecipe() {

// Test adding new recipes to the book
		assertTrue(book.addRecipe(recipe1), "Failed to add recipe1 to the book");
		assertTrue(book.addRecipe(recipe2), "Failed to add recipe2 to the book");
		assertFalse(book.addRecipe(recipe2), "Adding a recipe that already exists should return false");
		assertTrue(book.addRecipe(recipe3), "Failed to add recipe3 to the book");
		assertTrue(book.addRecipe(recipe4), "Failed to add recipe4 to the book");
