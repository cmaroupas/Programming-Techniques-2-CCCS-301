class CoffeeMakerTest {

	@Test
	void testCoffeeMaker() {
		// Create a new instance of the CoffeeMaker class
		CoffeeMaker coffeeMaker = new CoffeeMaker();

		// Verify that the CoffeeMaker instance was created successfully
		assertNotNull(coffeeMaker, "Encountered an error while creating a new instance of the CoffeeMaker class.");
	}

	// Testing if the addRecipe method works by creating a method by calling it
	@Test
	void testAddRecipe() {
		CoffeeMaker e = new CoffeeMaker();
		Recipe r1 = new Recipe();
		boolean value = e.addRecipe(r1);
		assertEquals(true, value);
	}

	@Test
	void testDeleteRecipe() {
		// Create a new instance of the CoffeeMaker class
		CoffeeMaker coffeeMaker = new CoffeeMaker();

		// Verify that removing a recipe from an empty list returns null
		String deletedRecipeName = coffeeMaker.deleteRecipe(0);
		assertNull(deletedRecipeName, "Removing a recipe from an empty list");
	}

	@Test
	void testEditRecipe() throws RecipeException {
		// Create a new instance of the CoffeeMaker class
		CoffeeMaker coffeeMaker = new CoffeeMaker();

		// Add a new recipe with some initial values
		Recipe recipe = new Recipe();
		recipe.setName("Espresso");
		recipe.setAmtCoffee("3");
		recipe.setAmtMilk("0");
		recipe.setAmtSugar("0");
		recipe.setAmtChocolate("0");
		coffeeMaker.addRecipe(recipe);

		// Modify the recipe with new values
		Recipe newRecipe = new Recipe();
		newRecipe.setName("Cappuccino");
		newRecipe.setAmtCoffee("2");
		newRecipe.setAmtMilk("1");
		newRecipe.setAmtSugar("1");
		newRecipe.setAmtChocolate("0");
		String editedRecipeName = coffeeMaker.editRecipe(0, newRecipe);

		// Assert that the edited recipe has the correct name
		assertEquals("Cappuccino", editedRecipeName, "The recipe name was not updated successfully.");
	}

	@Test
	void testAddInventory() {
		// Instantiate a new CoffeeMaker object
		CoffeeMaker coffeeMaker = new CoffeeMaker();

		// Verify that adding inventory with valid values returns true
		boolean isInventoryAdded = false;
		try {
			coffeeMaker.addInventory("100", "20", "30", "40");
			isInventoryAdded = true;
		} catch (InventoryException e) {
			// Ignore exception
		}
		assertTrue(isInventoryAdded, "Failed to add inventory with valid values");
	}

	@Test
	void testCheckInventory() {
		// Create a new instance of the CoffeeMaker class
		CoffeeMaker coffeeMaker = new CoffeeMaker();

		// Verify that invoking checkInventory() returns a non-null string
		String inventoryString = coffeeMaker.checkInventory();
		assertNotNull(inventoryString, "The checkInventory() method should return a non-null string.");
	}

	@Test
	void testMakeCoffee() throws RecipeException {
		// Create a new instance of the CoffeeMaker class
		CoffeeMaker coffeeMaker = new CoffeeMaker();

		// Add inventory with arbitrary values
		try {
			coffeeMaker.addInventory("5", "4", "3", "2");
		} catch (InventoryException e) {
			// Do nothing
		}

		// Add a recipe with custom values
		Recipe recipe = new Recipe();
		recipe.setName("Latte");
		recipe.setAmtCoffee("2");
		recipe.setAmtMilk("2");
		recipe.setAmtSugar("1");
		recipe.setAmtChocolate("0");
		coffeeMaker.addRecipe(recipe);

		// Verify that making a recipe with sufficient inventory returns the correct
		// change value
		int payment = 5;
		int change = coffeeMaker.makeCoffee(0, payment);
		int expectedChange = payment - recipe.getPrice();
		assertEquals(expectedChange, change, "Incorrect change value for recipe with sufficient inventory");
	}

	@Test
	void testGetRecipes() {
		// Create a new instance of the CoffeeMaker class
		CoffeeMaker coffeeMaker = new CoffeeMaker();

		// Verify that making a recipe with insufficient inventory returns the full
		// payment
		int payment = 3;
		int change = coffeeMaker.makeCoffee(0, payment);
		assertEquals(payment, change, "Incorrect change value for recipe with insufficient inventory");
	}
}

