/*
The Waitress class is a runnable that continuously serves combo meals from the ready table,
updating the number of combo meals and starting the threads for the BurgerChef and FriesChef classes.
 */
public class Waitress implements Runnable {
    private String name = "Waitress";
    private int WAIT_TIME = 1000;
    private int SERVE_TIME = 10000; // 10 second

    // Object to synchronize access between instances of the Waitress class
    private final Object waitressSync = new Object();
    // variable to keep track of the number of combo meals the Waitress has served
    public static int i = 1;
    // static variable to keep track of the number of combo meals on the ready table
    public static int combo;

    @Override
    public void run() {
        // infinite loop to keep serving combo meals
        while (true) {
            // synchronized block to ensure only one instance of the Waitress class can access the shared variables at a time
            synchronized (waitressSync) {
                // check if there are any combo meals on the ready table
                if (combo > 0) {
                    // check if the number of combo meals on the ready table is within the limit
                    if (combo <= ReadyTable.limit) {
                        // simulate the time taken to serve a combo meal
                        try {
                            Thread.sleep(SERVE_TIME);
                        } catch (InterruptedException e) {
                            // print a message if an exception occurs while sleeping
                            e.printStackTrace();
                        }
                        // decrease the number of combo meals on the ready table
                        combo--;
                        // print a message indicating that a combo meal was served
                        System.out.println("[Action] " + name +
                                " serves a meal");
                        // print a status update of the number of combo meals on the ready table
                        System.out.println("[Status] meals left: " + combo--);
                        System.out.println("-----------------------------------------------------------------------------------");
                        // start the threads for the BurgerChef and FriesChef classes

                        // An array of Runnable instances representing the BurgerChef and FriesChef classes
                        Runnable[] chefs = {new BurgerChef(), new FriesChef()};

                        // An array of strings representing the names of the threads for the chefs
                        String[] chefNames = {"Burger Chef", "Fries Chef"};

                        // Loop through the chefs array
                        for (int i = 0; i < chefs.length; i++) {
                            // Create a new thread for each chef and give it the name specified in the chefNames array
                            Thread chefThread = new Thread(chefs[i], chefNames[i]);
                            // Start the thread
                            chefThread.start();
                        }

                    } else {
                        // wait if there are more combo meals on the ready table than the limit
                        try {
                            waitressSync.wait();
                            Thread.sleep(WAIT_TIME);

                        } catch (InterruptedException e) {
                            // print a message if an exception occurs while waiting
                            e.printStackTrace();
                        }
                    }
                }
            }

        }
    }
}
