/*
The BurgerChef class is a runnable that continuously makes burgers and places them on the kitchen table,
and creates combo meals with fries when ingredients are available, updating the number of available burgers, combo meals, and ingredients.
 */
public class BurgerChef implements Runnable {
    private String name = "BurgerChef";
    private int WAIT_TIME = 1000;
    private int MAKE_TIME = 3000;
    // shared object to synchronize access between instances of the BurgerChef class
    public static Object burgerChefSync = new Object();
    // A static variable to keep track of the number of burgers on the kitchen table
    public static int availableBurgers = 0;

    @Override
    public void run() {
        // infinite loop to keep making burgers
        while (true) {
            // synchronized block to ensure only one instance of the BurgerChef class can access the shared variables at a time
            synchronized (burgerChefSync) {
                // check if there are enough ingredients to make a combo meal
                if (BurgerChef.availableBurgers > 1 && FriesChef.availableFries > 1) {
                    // check if there is room on the ready table for another combo meal
                    if (Waitress.combo < ReadyTable.limit) {
                        // decrease the number of burgers and fries
                        BurgerChef.availableBurgers--;
                        FriesChef.availableFries--;
                        // increase the number of combo meals on the ready table
                        Waitress.combo++;
                        // print a message indicating that a combo meal was made and placed on the ready table
                        System.out.println("[Action] " + name + " makes "
                                + " Burger and Fries "
                                + "and place it on the ready table");

                        // print a status update of the ingredients and combo meals
                        System.out.println("[Status] burgers left: " + availableBurgers +
                                ", fries left: " + FriesChef.availableFries + ", meals left: " + Waitress.combo);
                        System.out.println("===================================================================================");
                    }
                }

                // check if there is room on the kitchen table for another burger
                if (availableBurgers < KitchenTable.limit) {
                    // makes a burger
                    try {
                        Thread.sleep(MAKE_TIME);
                    } catch (InterruptedException e) {
                        // print a message if an exception occurs while sleeping
                        e.printStackTrace();
                    }
                    // increase the number of burgers on the kitchen table
                    BurgerChef.availableBurgers++;
                    // print a message indicating that a burger was added to the kitchen table
                    System.out.println("[Action] " + name +
                            " add a burger on the kitchen table");
                    // print a status update of the number of burgers on the kitchen table
                    System.out.println("[Status] burger left: " + BurgerChef.availableBurgers);

                } else {
                    // wait if there is no room on the kitchen table for another burger
                    try {
                        burgerChefSync.wait(WAIT_TIME);

                    } catch (InterruptedException e) {
                        // print a message if an exception occurs while waiting
                        e.printStackTrace();
                    }
                }
            }
        }
    }
}
